# Copy to .env (for `netlify dev`) and fill in. Never commit real values.
# In production these are Netlify environment variables scoped to Functions.

# Supabase project (Settings > API). The anon key is public by design; the
# functions call Supabase with it plus the member's own token.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Only the daily-reminders scheduled function (and the one-time Base44
# import script, run by an admin on their own machine) use this.
SUPABASE_SERVICE_ROLE_KEY=

# Sam's Club lookup (sams-lookup). The chapter's Console account, with a
# monthly spend limit.
ANTHROPIC_API_KEY=

# Email (notify, preauth-pdf, daily-reminders). Also set as the SMTP password
# in Supabase Auth so sign-in codes go out through Resend.
RESEND_API_KEY=
EMAIL_FROM="CPPHS FBLA Store <store@your-chapter-domain.org>"

# Where links in emails point (the frontend site).
APP_URL=http://localhost:5173
# Origins allowed to call the functions directly (local dev only; production
# goes through the frontend's /api proxy).
ALLOWED_ORIGINS=http://localhost:5173
