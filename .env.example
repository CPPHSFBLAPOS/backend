# Copy to .env (for `netlify dev`) and fill in. Never commit real values.
# In production these are Netlify environment variables scoped to Functions.

# Supabase project (Project Settings > API Keys). SUPABASE_ANON_KEY is the
# Publishable key (sb_publishable_..., or the legacy anon key): public by
# design; the functions call Supabase with it plus the member's own token.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# A Secret key (sb_secret_..., or the legacy service_role key). Only the
# daily-reminders scheduled function (and the one-time Base44 import script,
# run by an admin on their own machine) use this.
SUPABASE_SERVICE_ROLE_KEY=

# Sam's Club lookup (sams-lookup). The chapter's Console account, with a
# monthly spend limit.
ANTHROPIC_API_KEY=

# Email (notify, preauth-pdf, daily-reminders): set ONE of these. Brevo is
# used when its key is set. EMAIL_FROM's address must be a verified sender in
# Brevo, or on a verified domain in Resend. Sign-in codes go out through the
# SMTP settings in Supabase Auth, which can use the same service.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="CPPHS FBLA Store <store@your-chapter-domain.org>"

# Where links in emails point: the frontend site's https address in
# production (/api/health reports app_url false while it is still localhost).
APP_URL=http://localhost:5173
# Origins allowed to call the functions directly (local dev only; production
# goes through the frontend's /api proxy).
ALLOWED_ORIGINS=http://localhost:5173
